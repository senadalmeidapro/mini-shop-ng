server {
    listen 0.0.0.0:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # ${API_UPSTREAM} and ${RESOLVER_ADDR} are substituted at container start
    # (envsubst). The variable form defers DNS resolution to request time, so
    # nginx starts even if the backend service is not up yet.
    set $api_base ${API_UPSTREAM};

    # API reverse proxy: /api/* -> <backend>/* (same origin in production).
    # API_UPSTREAM points at the separately-deployed backend (e.g.
    # https://mini-shop-api-production-d245.up.railway.app); the /api prefix is stripped.
    location /api/ {
        resolver ${RESOLVER_ADDR} valid=30s ipv6=off;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_base;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = /api {
        return 301 /api/;
    }

    # index.html must always be revalidated so new deploys are picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed build artifacts (outputHashing: all) can be cached forever.
    location ~* \.(?:js|css|woff2?|ttf|eot|png|jpe?g|gif|ico|svg|webp|avif)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: every route is handled by the Angular router.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
